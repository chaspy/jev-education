{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jev-education-learning-path",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-19",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "observability": { "enabled": true },
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "200901", "simple": { "limit": 10, "period": 60 } },
    { "name": "GLOBAL_LIMITER", "namespace_id": "200902", "simple": { "limit": 100, "period": 60 } }
  ]
}

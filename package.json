{
  "name": "jev-education",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env scripts/dev.mjs",
    "start": "npm run dev",
    "test": "node --test apps/learning-path/test/*.test.mjs benchmarks/test/*.test.mjs",
    "build": "wrangler deploy --dry-run --outdir dist --config apps/learning-path/wrangler.jsonc",
    "deploy": "wrangler deploy --config apps/learning-path/wrangler.jsonc",
    "benchmark:prepare": "node benchmarks/prepare.mjs",
    "benchmark:mae": "node --env-file=.env benchmarks/run.mjs mae",
    "benchmark:demo": "node --env-file=.env benchmarks/run.mjs demo",
    "benchmark:simulation:prepare": "node benchmarks/simulation/prepare.mjs",
    "benchmark:simulation": "node --env-file=.env benchmarks/simulation/run.mjs"
  },
  "devDependencies": {
    "wrangler": "4.135.0"
  }
}
